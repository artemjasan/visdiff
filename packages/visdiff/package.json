{
  "name": "visdiff",
  "version": "0.1.0",
  "type": "module",
  "description": "Visual diff bridge: browser overlay edits → JSON tasks for coding agents (MCP). unplugin-based, TypeScript-first, npx-runnable.",
  "license": "MIT",
  "bin": {
    "visdiff": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    },
    "./rollup": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./webpack": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./rspack": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./rsbuild": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./rolldown": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./esbuild": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./farm": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./bun": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "element-source": "^0.0.5",
    "unplugin": "^3.4.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "sideEffects": [
    "dist/client.js"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
